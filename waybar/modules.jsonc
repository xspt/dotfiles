{
        "niri/workspaces": {
                "format": "{icon}",
                "format-icons": {
                        "music": "󰎆",
                        "default": "",
                        "active": "",
                }
        },
        "custom/prev": {
                "tooltip": false,
                "on-click": "playerctl -p $MUSIC_PLAYER previous",
                "format": "󰒮",
        },
        "custom/playerctl": {
                "exec": "~/.config/waybar/playerctl.sh",
                "tooltip": false,
                "on-click": "playerctl -p $MUSIC_PLAYER play-pause",
                "format": "{}",
                "escape": true,
        },
        "custom/next": {
                "tooltip": false,
                "on-click": "playerctl -p $MUSIC_PLAYER next",
                "format": "󰒭",
        },
        "privacy": {
                "modules": [
                        {
                                "type": "screenshare",
                        },
                        {
                                "type": "audio-out",
                        },
                        {
                                "type": "audio-in",
                        },
                ],
        },
        "pulseaudio": {
                "tooltip": false,
                "scroll-step": 2.0,
                "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
                "format-muted": "󰝟 Muted",
                "format": "{icon} {volume}%",
                "format-icons": {
                        "default": ["󰕿", "󰖀", "󰕾"],
                },
        },
        "clock": {
                "tooltip": true,
                "tooltip-format": "<tt><small>{calendar}</small></tt>",
                "format": " {:%H:%M}",
                "format-alt": " {:L%a, %d de %b}",
                "locale": "pt_BR.UTF-8",
                "actions": {
                        "on-scroll-down": "shift_up",
                        "on-scroll-up": "shift_down",
                        "on-click-middle": "shift_reset",
                        "on-click-right": "mode"
                }
        },
        "tray": {
                "icon-size": 18,
                "spacing": 18,
                "show-passive-items": true
        }
}
